{
  "id": "denon-lc6000-prime",
  "name": "Denon LC6000 PRIME",
  "device_hints": [
    "LC6000"
  ],
  "exclude_hints": [
    "LC6000 PRIME WD"
  ],
  "mapping": {
    "midi": {
      "input": "LC6000",
      "output": "LC6000",
      "channel": 1,
      "ignore_notes": [
        52
      ],
      "layers": [
        { "channel": 1, "deck": 1 },
        { "channel": 2, "deck": 2 },
        { "channel": 3, "deck": 3 },
        { "channel": 4, "deck": 4 }
      ],
      "layer_note": 51,
      "encoder_format": "twos_complement"
    },
    "osc": {
      "host": "127.0.0.1",
      "port": 9090,
      "root": "/Syndicate/",
      "feedback_host": "127.0.0.1",
      "feedback_port": 9096,
      "feedback_quiet_ms": 10000,
      "feedback_answer_ms": 2000
    },
    "deck": {
      "number": 1
    },
    "jog": {
      "msb_cc": 17,
      "lsb_cc": 49,
      "counts_per_rev": 3600,
      "bend_release_ms": 80,
      "seek_seconds_per_rev": 2.0,
      "beats_per_rev": 4,
      "require_touch": false
    },
    "pitch": {
      "bits": 14,
      "msb_cc": 8,
      "lsb_cc": 40,
      "invert": false,
      "dead_zone": 0.005,
      "pickup": true,
      "pickup_tolerance": 0.02
    },
    "needle": {
      "msb_cc": 64,
      "lsb_cc": 65,
      "touch_note": 70,
      "require_touch": true,
      "shift_fader": true,
      "shift_fader_mode": "relative"
    },
    "browse": {
      "select_turn_cc": 6,
      "auto_loop_size_cc": 3
    },
    "notes": {
      "play": 1,
      "cue": 2,
      "beat_jump_back": 3,
      "beat_jump_forward": 4,
      "track_prev": 5,
      "track_next": 6,
      "censor": 7,
      "loop_in": 8,
      "loop_out": 9,
      "auto_loop": 10,
      "back": 16,
      "forward": 17,
      "select_press": 18,
      "vinyl": 19,
      "sync": 20,
      "master": 21,
      "key_lock": 22,
      "deck_select": 23,
      "pitch_minus": 24,
      "pitch_plus": 25,
      "shift": 26,
      "mode_hotcue": 27,
      "mode_roll": 28,
      "mode_slicer": 29,
      "mode_loop": 30,
      "pads": [
        32,
        33,
        34,
        35,
        36,
        37,
        38,
        39
      ],
      "platter_touch": 40,
      "param_back": 68,
      "param_forward": 69
    },
    "leds": {
      "pitch_center": 42,
      "pitch_arrow_back": 41,
      "pitch_arrow_forward": 43,
      "ring": 40,
      "ring_color": [
        0,
        128,
        255
      ],
      "ring_follows_deck": true,
      "roll_pad_color": [
        255,
        140,
        0
      ],
      "loop_pad_color": [
        0,
        255,
        0
      ],
      "dim_unlit_buttons": true,
      "mirror_shifted": false,
      "beat_pulse": "off",
      "pulse_ms": 100,
      "stale_idle": "dim",
      "levels": { "full": 127, "dim": 1, "off": 0 },
      "color_table": "rgb222",
      "color_message": {
        "notes": [32, 33, 34, 35, 36, 37, 38, 39, 40]
      }
    },
    "pads": {
      "roll_sizes": ["ThirtySecond", "Sixteenth", "Eighth", "Quarter", "Half", "One", "Two", "Four"],
      "mode_select": "buttons"
    }
  }
}
